@inject proyecto.Data.VentaConsolasDb Db
@{
    ViewData["Title"] = "Inicio";
    Layout = null;

    var mx = new System.Globalization.CultureInfo("es-MX");

    // Consolas destacadas: las primeras 6 con existencias (sp_listar_stock)
    var destacadas = Db.ListarStock()
                       .Where(s => s.Disponible)
                       .OrderByDescending(s => s.PrecioUnitario)
                       .Take(6)
                       .ToList();
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VentaConsolas</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/tienda.css" asp-append-version="true">
    <link rel="icon" href="~/img/icon/favicon.ico">

    <style>
        html { scroll-padding-top: 4.5rem; }   /* para que las anclas no queden debajo del navbar */
        body { color: var(--color-smoke); }

        .portada {
            background: radial-gradient(circle at 80% 20%, rgba(0, 255, 238, .18), transparent 45%),
                        linear-gradient(135deg, #0b0070 0%, #050034 60%);
            border: 1px solid #1a1d5a;
            border-radius: 15px;
            padding: 4rem 2rem;
        }

        .portada .icono-portada {
            font-size: 9rem;
            line-height: 1;
            color: var(--color-cyan-neon);
            text-shadow: 0 0 40px rgba(0, 255, 238, .35);
        }

        .beneficio {
            background-color: var(--color-acero);
            border: 1px solid #2b303b;
            border-radius: 12px;
            padding: 1.5rem;
            height: 100%;
        }

        .beneficio .bi {
            font-size: 2rem;
            color: var(--color-cyan-neon);
        }

        .tarjeta-consola .card-body { color: var(--color-smoke); }

        .form-control, .form-select {
            background-color: #11141a;
            border-color: #2f3542;
            color: var(--color-smoke);
        }

        .form-control:focus, .form-select:focus {
            background-color: #11141a;
            color: var(--color-smoke);
            border-color: var(--color-cyan-neon);
        }
    </style>
</head>
<body>

    <!-- Barra de Navegación -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top">
            <div class="container-fluid">
                <!-- Marca del sitio -->
                <a class="navbar-brand" href="#inicio"><i class="bi bi-controller me-1"></i> VentaConsolas</a>

                <!-- Ícono de hamburguesa para móviles -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu" aria-controls="menu" aria-expanded="false" aria-label="Alternar navegación">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Menú colapsable -->
                <div class="collapse navbar-collapse" id="menu">
                    <ul class="navbar-nav">
                        <!-- estos se mueven dentro de esta página -->
                        <li class="nav-item">
                            <a class="nav-link active" aria-current="page" href="#inicio">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#destacadas">Destacadas</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#beneficios">¿Por qué comprar aquí?</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#contacto">Contacto</a>
                        </li>
                        <!-- estos ya cambian de paginas-->
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="MiCompra" asp-action="Index">Tienda</a>
                        </li>
                    </ul>

                    <!-- Botón de iniciar sesión (se oculta con sesión) + logo de perfil -->
                    <partial name="_NavUsuario" />
                </div>
            </div>
        </nav>
    </header>


    <main style="padding-top: 4.5rem;">

        <!-- Mensajes (por ejemplo, al cerrar sesión o al intentar entrar al panel sin ser admin) -->
        <div class="container">
            <partial name="_Alertas" />
        </div>

        <!-- Sección Portada -->
        <div class="container mt-4" id="inicio">
            <div class="portada">
                <div class="row align-items-center g-4">
                    <div class="col-md-8">
                        <h1 class="display-5 fw-bold">Tu próxima consola está aquí</h1>
                        <p class="lead mb-4">
                            PlayStation, Xbox, Nintendo y Steam Deck al mejor precio.
                            Revisa existencias en tiempo real y compra en unos cuantos clics.
                        </p>
                        <div class="d-flex flex-wrap gap-2">
                            <a class="btn btn-primary btn-lg" asp-controller="MiCompra" asp-action="Index">
                                <i class="bi bi-bag me-1"></i> Ver tienda
                            </a>
                            <a href="#destacadas" class="btn btn-outline-light btn-lg">Destacadas</a>
                        </div>
                    </div>
                    <div class="col-md-4 text-center d-none d-md-block">
                        <i class="bi bi-controller icono-portada"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sección Consolas destacadas -->
        <div class="container mt-5" id="destacadas">
            <div class="d-flex flex-wrap align-items-end justify-content-between gap-2 mb-4">
                <div>
                    <h2 class="mb-1">Consolas destacadas</h2>
                    <p class="texto-tenue mb-0">Precios sin IVA.</p>
                </div>
                <a class="btn btn-outline-light btn-sm" asp-controller="MiCompra" asp-action="Index">Ver todas</a>
            </div>

            @if (destacadas.Count == 0)
            {
                <div class="alert alert-info">Por ahora no hay consolas disponibles.</div>
            }
            else
            {
                <div class="row g-4">
                    @foreach (var s in destacadas)
                    {
                        <div class="col-12 col-sm-6 col-lg-4">
                            <div class="card h-100 tarjeta-consola">
                                @if (!string.IsNullOrWhiteSpace(s.Imagen))
                                {
                                    <img src="@Url.Content(s.Imagen)" class="card-img-top" alt="@s.Consola">
                                }
                                else
                                {
                                    <div class="imagen-consola-vacia card-img-top"><i class="bi bi-controller"></i></div>
                                }
                                <div class="card-body d-flex flex-column">
                                    <h5 class="card-title mb-1">@s.Consola</h5>
                                    <p class="texto-tenue small mb-2">@s.Modelo</p>
                                    <div class="precio mb-1">@s.PrecioUnitario.ToString("C", mx)</div>
                                    <p class="small text-success mb-3"><i class="bi bi-check-circle"></i> @s.Existencias disponibles</p>
                                    <a class="btn btn-primary mt-auto" asp-controller="MiCompra" asp-action="Confirmar" asp-route-idConsola="@s.IdConsola">
                                        <i class="bi bi-cart-plus me-1"></i> Comprar
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Sección ¿Por qué comprar aquí? -->
        <div class="container mt-5" id="beneficios">
            <h2 class="mb-4">¿Por qué comprar aquí?</h2>
            <div class="row g-4">
                <div class="col-12 col-md-6 col-lg-3">
                    <div class="beneficio">
                        <i class="bi bi-box-seam"></i>
                        <h5 class="mt-3">Existencias reales</h5>
                        <p class="mb-0 texto-tenue">Lo que ves en la tienda es lo que hay en almacén.</p>
                    </div>
                </div>
                <div class="col-12 col-md-6 col-lg-3">
                    <div class="beneficio">
                        <i class="bi bi-receipt"></i>
                        <h5 class="mt-3">Precios claros</h5>
                        <p class="mb-0 texto-tenue">Ves el subtotal, el IVA y el total antes de confirmar.</p>
                    </div>
                </div>
                <div class="col-12 col-md-6 col-lg-3">
                    <div class="beneficio">
                        <i class="bi bi-globe-americas"></i>
                        <h5 class="mt-3">Varias regiones</h5>
                        <p class="mb-0 texto-tenue">Modelos de región americana, europea y asiática.</p>
                    </div>
                </div>
                <div class="col-12 col-md-6 col-lg-3">
                    <div class="beneficio">
                        <i class="bi bi-clock-history"></i>
                        <h5 class="mt-3">Historial de compras</h5>
                        <p class="mb-0 texto-tenue">Consulta tus folios cuando quieras desde tu cuenta.</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sección de Contacto -->
        <div class="container mt-5 mb-5" id="contacto">
            <h2>Contacto</h2>

            <div class="alert alert-info mt-3" role="alert">
                <strong>¡Hola!</strong> ¿Dudas sobre un pedido o una consola? Envíanos un mensaje y te responderemos lo antes posible.
            </div>

            <form class="mt-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label for="nombreUsuario" class="form-label">Nombre completo</label>
                        <input type="text" class="form-control" id="nombreUsuario" placeholder="Ej. Juan Pérez" required>
                    </div>
                    <div class="col-md-6">
                        <label for="correoUsuario" class="form-label">Correo electrónico</label>
                        <input type="email" class="form-control" id="correoUsuario" placeholder="nombre@ejemplo.com" required>
                    </div>
                    <div class="col-12">
                        <label for="asuntoMensaje" class="form-label">Asunto</label>
                        <select class="form-select" id="asuntoMensaje" required>
                            <option value="" selected disabled>Selecciona un asunto...</option>
                            <option value="pedido">Estado de mi pedido</option>
                            <option value="disponibilidad">Disponibilidad de una consola</option>
                            <option value="garantia">Garantía</option>
                            <option value="otro">Otro</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label for="mensajeUsuario" class="form-label">Mensaje</label>
                        <textarea class="form-control" id="mensajeUsuario" rows="4" required></textarea>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary mt-3">Enviar mensaje</button>
            </form>
        </div>

    </main>

    <footer class="pie py-3 text-center small">
        &copy; @DateTime.Now.Year VentaConsolas
    </footer>

    <!-- CDN del JavaScript bundle de Bootstrap 5 -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
