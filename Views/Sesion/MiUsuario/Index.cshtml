@model Usuario
@{
    ViewData["Title"] = "Mi usuario";
}

<div class="panel panel-medio">
    <div class="d-flex flex-column flex-sm-row align-items-sm-center gap-3 mb-4">
        <i class="bi bi-person-circle avatar-grande"></i>
        <div class="flex-grow-1">
            <h1 class="h3 mb-1">@Model.Nombre</h1>
            @if (Model.Esadmin == true)
            {
                <span class="badge text-bg-warning"><i class="bi bi-shield-check me-1"></i>Administrador</span>
            }
            else
            {
                <span class="badge text-bg-secondary">Cliente</span>
            }
        </div>

        <div class="d-flex gap-2">
            <a class="btn btn-primary btn-sm" asp-controller="Sesion" asp-action="Actualizar">
                <i class="bi bi-pencil-square me-1"></i> Actualizar información
            </a>
            <a class="btn btn-outline-light btn-sm" asp-controller="Sesion" asp-action="Secret">
                <i class="bi bi-key me-1"></i> Cambiar contraseña
            </a>
        </div>
    </div>

    <div class="dato">
        <div class="dato-etiqueta">Número de usuario</div>
        <div>@Model.Id</div>
    </div>
    <div class="dato">
        <div class="dato-etiqueta">Nombre</div>
        <div>@Model.Nombre</div>
    </div>
    <div class="dato">
        <div class="dato-etiqueta">Correo electrónico</div>
        <div>@(Model.Correo ?? "Sin correo")</div>
    </div>
    <div class="dato">
        <div class="dato-etiqueta">Teléfono</div>
        <div>@(Model.Telefono ?? "Sin teléfono")</div>
    </div>
    <div class="dato">
        <div class="dato-etiqueta">Estado</div>
        <div>@(Model.Activo == true ? "Activo" : "Dado de baja")</div>
    </div>

    <div class="d-flex flex-wrap gap-2 mt-4">
        <a class="btn btn-outline-primary btn-sm" asp-controller="MiCompra" asp-action="Historial">
            <i class="bi bi-receipt me-1"></i> Mis compras
        </a>
        @if (Model.Esadmin == true)
        {
            <a class="btn btn-outline-primary btn-sm" asp-controller="Admin" asp-action="Index">
                <i class="bi bi-speedometer2 me-1"></i> Panel de administrador
            </a>
        }
        <button type="button" class="btn btn-outline-danger btn-sm ms-auto" data-bs-toggle="modal" data-bs-target="#modalBaja">
            <i class="bi bi-person-x me-1"></i> Dar de baja mi cuenta
        </button>
    </div>
</div>

<!-- Confirmación para dar de baja (pide la contraseña) -->
<div class="modal fade" id="modalBaja" tabindex="-1" aria-labelledby="modalBajaTitulo" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content" asp-controller="Sesion" asp-action="DarDeBaja" method="post">
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="modalBajaTitulo">Dar de baja mi cuenta</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p>Tu cuenta quedará inactiva y se cerrará la sesión. Escribe tu contraseña para confirmar.</p>
                <label for="contraseniaBaja" class="form-label">Contraseña</label>
                <input type="password" class="form-control" id="contraseniaBaja" name="contrasenia" required autocomplete="current-password">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-danger">Dar de baja</button>
            </div>
        </form>
    </div>
</div>
