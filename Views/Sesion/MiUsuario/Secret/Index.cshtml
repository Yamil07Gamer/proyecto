@model CambiarContraseniaViewModel
@{
    ViewData["Title"] = "Cambiar contraseña";
}

<div class="panel panel-angosto">
    <div class="panel-titulo">
        <i class="bi bi-key"></i>
        <h1>Cambiar contraseña</h1>
    </div>

    <form asp-controller="Sesion" asp-action="Secret" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

        <div class="mb-3">
            <label asp-for="ContraseniaActual" class="form-label"></label>
            <input asp-for="ContraseniaActual" class="form-control" autocomplete="current-password">
            <span asp-validation-for="ContraseniaActual" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ContraseniaNueva" class="form-label"></label>
            <input asp-for="ContraseniaNueva" class="form-control" autocomplete="new-password">
            <span asp-validation-for="ContraseniaNueva" class="text-danger small"></span>
        </div>

        <div class="mb-4">
            <label asp-for="ConfirmarContrasenia" class="form-label"></label>
            <input asp-for="ConfirmarContrasenia" class="form-control" autocomplete="new-password">
            <span asp-validation-for="ConfirmarContrasenia" class="text-danger small"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-fill">
                <i class="bi bi-check2 me-1"></i> Cambiar contraseña
            </button>
            <a class="btn btn-outline-light flex-fill" asp-controller="Sesion" asp-action="MiUsuario">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
