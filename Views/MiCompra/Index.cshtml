@model List<StockListado>
@{
    ViewData["Title"] = "Tienda";
    var mx = new System.Globalization.CultureInfo("es-MX");
    var haySesion = SesionUsuario.HaySesion(Context.Session);
}

<div class="d-flex flex-wrap align-items-end justify-content-between gap-2 mb-4">
    <div>
        <h1 class="h2 mb-1">Consolas</h1>
        <p class="texto-tenue mb-0">Precios sin IVA. El IVA (16 %) se calcula al confirmar.</p>
    </div>
    @if (haySesion)
    {
        <a class="btn btn-outline-light btn-sm" asp-action="Historial"><i class="bi bi-receipt me-1"></i> Mis compras</a>
    }
</div>

@if (!haySesion)
{
    <div class="alert alert-info">
        Puedes ver el catálogo sin cuenta. Para comprar, <a asp-controller="Sesion" asp-action="Login" asp-route-returnUrl="/MiCompra">inicia sesión</a>.
    </div>
}

<div class="row g-4">
    @foreach (var s in Model)
    {
        <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
            <div class="card h-100 tarjeta-consola">
                @if (!string.IsNullOrWhiteSpace(s.Imagen))
                {
                    <img src="@Url.Content(s.Imagen)" class="card-img-top" alt="@s.Consola">
                }
                else
                {
                    <div class="imagen-consola-vacia card-img-top"><i class="bi bi-controller"></i></div>
                }

                <div class="card-body d-flex flex-column">
                    <h2 class="h5 card-title mb-1">@s.Consola</h2>
                    <p class="texto-tenue small mb-2">@s.Modelo</p>
                    <div class="precio mb-1">@s.PrecioUnitario.ToString("C", mx)</div>
                    <p class="small mb-3">
                        @if (s.Disponible)
                        {
                            <span class="text-success"><i class="bi bi-check-circle"></i> @s.Existencias disponibles</span>
                        }
                        else
                        {
                            <span class="text-danger"><i class="bi bi-x-circle"></i> Agotado</span>
                        }
                    </p>

                    @if (s.Disponible)
                    {
                        <a class="btn btn-primary mt-auto" asp-action="Confirmar" asp-route-idConsola="@s.IdConsola">
                            <i class="bi bi-cart-plus me-1"></i> Comprar
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-secondary mt-auto" disabled>Agotado</button>
                    }
                </div>
            </div>
        </div>
    }
</div>
