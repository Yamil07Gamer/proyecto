@model Ventum
@{
    ViewData["Title"] = $"Compra #{Model.Folio}";
    var mx = new System.Globalization.CultureInfo("es-MX");
    var iva = Model.Total - Model.Subtotal;
}

<div class="panel panel-medio">
    <div class="text-center mb-4">
        <i class="bi bi-receipt text-success" style="font-size: 3rem;"></i>
        <h1 class="h3 mt-2 mb-1">Compra #@Model.Folio</h1>
        <p class="texto-tenue mb-0">@Model.IdUsuarioNavigation.Nombre</p>
    </div>

    <table class="w-100 tabla-calculo">
        @foreach (var d in Model.VentaConsolas)
        {
            <tr>
                <td>@d.Cantidad × @d.IdConsolaNavigation.Nombre</td>
                <td class="text-end">@d.Subtotal.ToString("C", mx)</td>
            </tr>
        }
        <tr>
            <td>Subtotal</td>
            <td class="text-end">@Model.Subtotal.ToString("C", mx)</td>
        </tr>
        <tr>
            <td>IVA</td>
            <td class="text-end">@iva.ToString("C", mx)</td>
        </tr>
        <tr class="total">
            <td>Total</td>
            <td class="text-end precio">@Model.Total.ToString("C", mx)</td>
        </tr>
    </table>

    <div class="d-flex flex-wrap gap-2 mt-4">
        <a class="btn btn-primary" asp-action="Index"><i class="bi bi-bag me-1"></i> Seguir comprando</a>
        <a class="btn btn-outline-light" asp-action="Historial"><i class="bi bi-receipt me-1"></i> Mis compras</a>
    </div>
</div>
